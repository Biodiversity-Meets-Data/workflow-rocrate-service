# App
APP_NAME=workflow-rocrate-service

# LifeWatch engine
LIFEWATCH_KEYCLOAK_ISSUER=link-to-lifewatch-keycloak-issuer
LIFEWATCH_BASE_URL=link-to-lifewatch-workflow-base-url
LIFEWATCH_ANNOTATIONS_PREFIX=lifewatch
LIFEWATCH_LABELS_PREFIX=workflows.lifewatch.eu

# Dummy engine
DUMMY_ANNOTATIONS_PREFIX=dummy
DUMMY_LABELS_PREFIX=workflows.argoproj.io
DUMMY_BASE_URL=http://localhost:8000/workflow-engines/dummy/workflows

# Local (Argo) engine
LOCAL_ANNOTATIONS_PREFIX=tbd
LOCAL_LABELS_PREFIX=tbd
LOCAL_BASE_URL=http://localhost:8000/workflow-engines/local/workflows
LOCAL_ARGO_TOKEN=local-argo-token
LOCAL_ARGO_HOST=http://localhost:2746
LOCAL_ARGO_NAMESPACE=argo
LOCAL_ARGO_ARTIFACT_ACCESS_KEY=minio-access-key
LOCAL_ARGO_ARTIFACT_SECRET_KEY=minio-secret-key
LOCAL_ARGO_ARTIFACT_ENDPOINT=localhost:9000
