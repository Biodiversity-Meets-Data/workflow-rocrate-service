# Nested override format:
# <ROOT>__<DEPLOYMENT_NAME>__... using env_nested_delimiter="__"
# Root keys for this project are APP and DEPLOYMENTS (no prefix required).

# -----------------------------------------------------------------------------
# Required secret keys (recommended in .env)
# -----------------------------------------------------------------------------

# Local Argo deployment secrets
DEPLOYMENTS__LOCAL__AUTH__TOKEN=local-api-token
DEPLOYMENTS__LOCAL__ARGO__TOKEN=local-argo-token
DEPLOYMENTS__LOCAL__ARGO__ARTIFACT_ACCESS_KEY=minio-access-key
DEPLOYMENTS__LOCAL__ARGO__ARTIFACT_SECRET_KEY=minio-secret-key

# Juelich Argo deployment secrets
DEPLOYMENTS__JUELICH__ARGO__TOKEN=juelich-argo-token
DEPLOYMENTS__JUELICH__ARGO__ARTIFACT_ACCESS_KEY=juelich-artifact-access-key
DEPLOYMENTS__JUELICH__ARGO__ARTIFACT_SECRET_KEY=juelich-artifact-secret-key
DEPLOYMENTS__JUELICH__AUTH__ISSUER=https://auth.lifewatch.eu/realms/lifewatcheric

# LifeWatch deployment auth secrets
DEPLOYMENTS__LIFEWATCH__AUTH__ISSUER=https://auth.lifewatch.eu/realms/lifewatcheric